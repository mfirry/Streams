cabal-version:       2.2

name:                conduit-example
version:             0.1.0.0
-- synopsis:
-- description:
homepage:            https://github.com/githubuser/conduit-example#readme
license:             BSD-3-Clause
build-type:          Simple

executable conduit-example
  hs-source-dirs:      src
  main-is:             Main.hs
  default-language:    Haskell2010
  build-depends:       base >= 4.11 && < 5,
                       conduit >=1.3.5
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-record-updates
                       -Wincomplete-uni-patterns
                       -Wmissing-export-lists
                       -Wmissing-home-modules
                       -Wpartial-fields
                       -Wredundant-constraints
